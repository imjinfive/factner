{
  "$schema": "node_modules/wrangler/config-schema.json",
  "account_id": "9253dd1d6c8b00b6bee6dfcf3ff080f4",
  "name": "factner-main",
  "main": "server/public-worker.js",
  "compatibility_date": "2026-10-19",
  "workers_dev": false,
  "routes": [
    {
      "pattern": "factner.com",
      "custom_domain": true
    },
    {
      "pattern": "www.factner.com",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "./rebate-ui/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*",
      "/_local-admin/api/*"
    ]
  },
  "vars": {
    "APP_KIND": "main",
    "DRAFT_SIGNUP_ENABLED": "1",
    "TURNSTILE_SITE_KEY": "0x4AAAAAAFbVVs9UqZ4yQIFU"
  },
  "durable_objects": { "bindings": [{ "name": "BID_ROOMS", "class_name": "BidRoom" }] },
  "migrations": [{ "tag": "bid-review-v1", "new_sqlite_classes": ["BidRoom"] }],
  "rules": [{ "type": "Text", "globs": ["**/*.sql"], "fallthrough": true }],
  "ratelimits": [{ "name": "BID_LIMIT", "namespace_id": "1001", "simple": { "limit": 150, "period": 60 } }],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "factner-db",
      "database_id": "404584fd-6ae3-483e-af2e-4999f343a6b1",
      "migrations_dir": "migrations"
    }
  ]
}
